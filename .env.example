# Entorno
SERVIMETERS_APP_ENV=production
SERVIMETERS_TIMEZONE=America/Bogota
SERVIMETERS_TRUST_PROXY=true
SERVIMETERS_HTTP_PORT=8080

# PostgreSQL institucional
SERVIMETERS_DB_DRIVER=pgsql
SERVIMETERS_DB_HOST=postgresql.internal
SERVIMETERS_DB_PORT=5432
SERVIMETERS_DB_NAME=servimeters_producto
SERVIMETERS_DB_SCHEMA=servimeters_producto
SERVIMETERS_DB_USERNAME=servimeters_producto_app
SERVIMETERS_DB_PASSWORD=change-me
SERVIMETERS_DB_SSLMODE=require

# Directorios privados y escribibles
SERVIMETERS_SESSION_PATH=/var/www/html/storage/sessions
SERVIMETERS_TEMP_PATH=/var/www/html/tmp

# Analizador Python aislado
SERVIMETERS_PYTHON_PATH=/opt/servimeters/venv/bin/python
SERVIMETERS_ANALYSIS_TIMEOUT=90
SERVIMETERS_ANALYSIS_RETENTION_HOURS=24
SERVIMETERS_GEMINI_API_KEY=
SERVIMETERS_GEMINI_MODEL=gemini-2.5-flash

# Correo SMTP (opcional)
SERVIMETERS_SMTP_ENABLED=false
SERVIMETERS_SMTP_HOST=smtp.office365.com
SERVIMETERS_SMTP_PORT=587
SERVIMETERS_SMTP_ENCRYPTION=tls
SERVIMETERS_SMTP_USERNAME=
SERVIMETERS_SMTP_PASSWORD=
SERVIMETERS_SMTP_FROM_EMAIL=notificaciones@servimeters.com
SERVIMETERS_SMTP_FROM_NAME=Servimeters - Solicitudes de producto
SERVIMETERS_SMTP_TIMEOUT=15
